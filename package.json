{
  "name": "magpie-capy",
  "version": "0.6.1",
  "description": "Capy provider plugin for magpie: headless device, native SSE, image/PDF attachments, zero runtime dependencies.",
  "type": "module",
  "main": "dist/index.mjs",
  "exports": "./dist/index.mjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/entry/plugin.ts --outfile dist/index.mjs --target bun --format esm",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.mjs"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "magpie",
    "capy",
    "provider",
    "headless",
    "sse"
  ],
  "license": "MIT",
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 2
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baijiu666/magpie-Capy.git"
  },
  "homepage": "https://github.com/baijiu666/magpie-Capy#readme",
  "bugs": {
    "url": "https://github.com/baijiu666/magpie-Capy/issues"
  }
}
